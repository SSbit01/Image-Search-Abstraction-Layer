    meta(http-equiv="X-UA-Compatible", content="IE=edge")

    link(rel="shortcut icon", href="/favicon.ico")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css",
